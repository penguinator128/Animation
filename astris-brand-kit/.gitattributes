# Git LFS: videos, audio, zips and the big images live in LFS so the repo itself stays light.
# One-time setup on a new machine:  git lfs install
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*-master-*.png filter=lfs diff=lfs merge=lfs -text
