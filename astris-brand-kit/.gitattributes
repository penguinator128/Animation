# Git LFS: videos, audio, zips and the big images live in LFS so the repo itself stays light.
# One-time setup on a new machine:  git lfs install
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*-master-*.png filter=lfs diff=lfs merge=lfs -text
# posters (print-size JPEGs) and the 4096 px seamless textures
**/posters/*.jpg filter=lfs diff=lfs merge=lfs -text
*-4096x4096.png filter=lfs diff=lfs merge=lfs -text
# full-frame 4K stills
*-3840x2160.png filter=lfs diff=lfs merge=lfs -text
# phone wallpapers and the bottle wrap artwork (full-bleed grain images)
**/phone-wallpapers/*.png filter=lfs diff=lfs merge=lfs -text
*-300dpi.png filter=lfs diff=lfs merge=lfs -text
# contact sheets, the gallery page, the brand guides and their page pictures
overview.png filter=lfs diff=lfs merge=lfs -text
/compare-styles.png filter=lfs diff=lfs merge=lfs -text
/preview.html filter=lfs diff=lfs merge=lfs -text
*-brand-guide-*.pdf filter=lfs diff=lfs merge=lfs -text
**/01_Brand-Guide/pages/*.png filter=lfs diff=lfs merge=lfs -text
